# Server Configuration
# PORT is set automatically by Railway - don't set manually
NODE_ENV=production

# Session Secret (REQUIRED - generate a random string for production)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-here-change-in-production

# Database Path
# For Railway: Create a Volume mounted at /data, then set:
DATABASE_PATH=/data/crm.db
# For local development, defaults to ./data/crm.db if not set

# AI / Anthropic (REQUIRED for email classification & candidate matching)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional tuning for the shared AI concurrency gate (src/lib/ai-client.js).
# Defaults shown; raise AI_MAX_CONCURRENCY toward your Anthropic tier's limits.
# AI_MAX_CONCURRENCY=4
# AI_MAX_RETRIES=3
# AI_REQUEST_TIMEOUT_MS=120000
